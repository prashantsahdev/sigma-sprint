rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is Admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "aashiksah083@gmail.com";
    }

    // 1. USERS
    match /users/{userId} {
      allow read: if request.auth != null;
      // Users can only edit themselves. Admin can edit anyone.
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());

      match /following/{followedId} { allow read, write: if request.auth != null; }
      match /followers/{followerId} { allow read, write: if request.auth != null; }
    }

    // 2. COMMUNITY POSTS 
    match /posts/{postId} {
      allow read: if request.auth != null;
      // Must be logged in AND verified to post
      allow create: if request.auth != null && request.auth.token.email_verified == true;
      
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      
      allow update: if request.auth != null && (
        resource.data.uid == request.auth.uid || 
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
      );

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.token.email_verified == true;
        allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }

    // 3. CONTENT (Questions, Sets, Curriculum, Announcements)
    // Anyone can read these. ONLY Admin can write.
    match /questions/{id} { allow read: if true; allow write: if isAdmin(); }
    match /sets/{id} { allow read: if true; allow write: if isAdmin(); }
    match /curriculum/{id} { allow read: if true; allow write: if isAdmin(); }
    match /announcements/{id} { allow read: if true; allow write: if isAdmin(); }
    match /system/{id} { allow read: if request.auth != null; allow write: if isAdmin(); }

    // IMPORTANT: No catch-all at the bottom. 
    // If it's not explicitly allowed above, it's blocked!
  }
}